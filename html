<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>System Alert</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      background: #000;
      color: #0f0;
      font-family: 'Courier New', monospace;
      overflow: hidden;
      height: 100vh;
    }
    #terminal {
      padding: 20px;
      font-size: 13px;
      line-height: 1.6;
    }
    .red { color: #f00; }
    .blink { animation: blink 0.8s step-end infinite; }
    @keyframes blink { 50% { opacity: 0; } }
    #warning {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      text-align: center;
      font-size: 22px;
      color: #f00;
      display: none;
      text-shadow: 0 0 10px #f00;
      padding: 20px;
    }
  </style>
</head>
<body>
  <div id="terminal"></div>
  <div id="warning">
    ⚠️ ACCESS GRANTED ⚠️<br>
    <span style="font-size:14px">jk you just got pranked lmao</span>
  </div>

  <script>
    const lines = [
      "Initializing payload...",
      "Scanning device fingerprint... DONE",
      "IMEI: " + Math.floor(Math.random() * 9e14 + 1e14),
      "OS: Android " + (Math.floor(Math.random() * 3) + 12) + ".0",
      "Bypassing root detection...",
      "Injecting into system process [com.android.system]...",
      "Reading contacts... 147 found",
      "Reading messages... 2,341 found",
      "Locating GPS coordinates...",
      "  → " + (Math.random() * 180 - 90).toFixed(6) + ", " + (Math.random() * 360 - 180).toFixed(6),
      "Uploading data to remote server [185.220.101.47]...",
      "[##########] 100%",
      "Exfiltration complete.",
      "Installing persistence backdoor...",
      "DEVICE COMPROMISED ▮",
    ];

    const terminal = document.getElementById('terminal');
    let i = 0;

    function typeLine() {
      if (i >= lines.length) {
        setTimeout(() => {
          terminal.style.display = 'none';
          document.getElementById('warning').style.display = 'block';
        }, 1500);
        return;
      }
      const div = document.createElement('div');
      if (lines[i].includes('COMPROMISED') || lines[i].includes('GRANTED')) {
        div.classList.add('red');
      }
      terminal.appendChild(div);

      let j = 0;
      const line = lines[i];
      const interval = setInterval(() => {
        div.textContent = line.slice(0, j++);
        if (j > line.length) {
          clearInterval(interval);
          i++;
          setTimeout(typeLine, Math.random() * 300 + 100);
        }
      }, 18);

      terminal.scrollTop = terminal.scrollHeight;
    }

    typeLine();
  </script>
</body>
</html>
